# Copy to .env and fill in. api.main calls load_env() at import, before anything
# reads os.environ; real environment variables still win over this file.

# ---------- Metabase (lead source) ----------
METABASE_URL=https://metabase-internal.formi.co.in
METABASE_API_KEY=
METABASE_DB_ID=2

# ---------- Formi (dialling) ----------
# The same name the rest of the Chola tooling reads, so one .env serves all of
# them. FORMI_TOKEN is still honoured if you have it exported.
FORMI_API_KEY=
CHOLA_OUTLET_ID=1497

# There is deliberately no CAMPAIGN_IDS here. This file used to carry a list of
# 25 ids that nothing read: `engine.sync` discovers campaigns from the warehouse
# (newest first, must have leads with a parseable RED, must not be named like a
# test campaign). A hand-kept list is what left the reports counting six
# campaigns short for four nights, and a list nobody reads is worse still --
# editing it looks like it changed something.

# ---------- Safety ----------
# DRY_RUN=1 means the dispatcher records what it WOULD send and never touches
# the network: every dialling helper checks db.dry_run() as its first statement
# and imports requests only after that check passes. Set 0 only when you mean
# to place real calls to real customers.
DRY_RUN=1

# NOT read for planning. The engine always plans from the local `leads` table --
# whatever `engine.sync` or `engine.seed` last wrote. `/api/health` reports
# `seed` or `warehouse` by inspecting the campaign ids it actually holds, so it
# cannot disagree with the data. Kept because the seeding scripts read it.
LEADS_SOURCE=seed

# SQLite path. Relative paths are relative to the working directory, so the
# service file's WorkingDirectory decides which database a deploy talks to.
REDIAL_DB=./redial.db

# Point load_env() at a different file. Read before anything else, so it cannot
# itself live in the file it selects.
# REDIAL_ENV_FILE=/opt/apps/redial/.env

# ---------- Agents ----------
# `id:Language` pairs. `GET /api/agents` labels each agent from this, and the
# day screen puts the label on the panel the operator approves. It lives here
# rather than in the UI because "125 is Hindi" is a fact about this deployment,
# not about the code -- a third agent should need an edit here and nothing else.
# Unset, agents answer `language: null` and everything else works as before. A
# malformed entry (`127` with no label, `x:Hindi`) stops the API at BOOT, naming
# the entry, rather than labelling an agent wrong: the wrong language on a
# dialling console is a script read to the wrong cohort. At boot and not merely
# on the request, because the console falls back to an unlabelled roster when
# /api/agents fails -- the labels would just quietly vanish.
AGENT_LANGUAGES=125:Hindi,127:Tamil

# There is deliberately no WAVE_BOUNDARY here either. It used to split the day
# into a morning `auto` wave and an afternoon `auto_pm` one, and it was removed
# from the code on 14 Sep 2026 along with the bands: "twice a day" means "again
# after the first call", not "again after lunch", so which pass a plan is, is
# decided by the previous call and not by the clock. `tests/test_day.py` asserts
# the name is gone. Setting it here does nothing.

# ---------- The clock ----------
# When the two passes PREPARE. Neither of them dials -- the first pass writes a
# `planned` run and waits for a human to press Approve on the day screen.
AUTOPILOT_AM=10:00
AUTOPILOT_PM=15:00

# The recall is the one thing that dials unattended: it chases people today's
# APPROVED pass already called and did not reach. 0 switches it off, including
# its manual endpoint -- a kill switch with a bypass beside it is not a kill
# switch.
AUTO_RECALL=1

# ---------- Limits ----------
# How fast schedules are posted to Formi, in requests per second.
FORMI_POST_RATE_PER_SEC=10

# Metabase refuses to return more than this many rows per query; raise it only
# when the warehouse's own server-side limit is raised.
METABASE_ROW_CAP=2000

# How many days of call-log rows to keep.
DIAL_LOG_DAYS=90
