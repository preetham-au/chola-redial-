# Copy to .env and fill in. api.main calls load_env() at import, before anything
# reads os.environ; real environment variables still win over this file.

# ---------- Metabase (lead source) ----------
METABASE_URL=https://metabase-internal.formi.co.in
METABASE_API_KEY=
METABASE_DB_ID=2

# ---------- Formi (dialling) ----------
# The same name the rest of the Chola tooling reads, so one .env serves all of
# them. FORMI_TOKEN is still honoured if you have it exported.
FORMI_API_KEY=
CHOLA_OUTLET_ID=1497

# There is deliberately no CAMPAIGN_IDS here. This file used to carry a list of
# 25 ids that nothing read: `engine.sync` discovers campaigns from the warehouse
# (newest first, must have leads with a parseable RED, must not be named like a
# test campaign). A hand-kept list is what left the reports counting six
# campaigns short for four nights, and a list nobody reads is worse still --
# editing it looks like it changed something.

# ---------- Safety ----------
# DRY_RUN=1 means the dispatcher records what it WOULD send and never touches
# the network: every dialling helper checks db.dry_run() as its first statement
# and imports requests only after that check passes. Set 0 only when you mean
# to place real calls to real customers.
DRY_RUN=1

# seed = the local fixture set; metabase = pull live leads.
LEADS_SOURCE=seed

# ---------- Agents ----------
# `id:Language` pairs. `GET /api/agents` labels each agent from this, and the
# day screen puts the label on the panel the operator approves. It lives here
# rather than in the UI because "125 is Hindi" is a fact about this deployment,
# not about the code -- a third agent should need an edit here and nothing else.
# Unset, agents answer `language: null` and everything else works as before. A
# malformed entry (`127` with no label, `x:Hindi`) stops the API at BOOT, naming
# the entry, rather than labelling an agent wrong: the wrong language on a
# dialling console is a script read to the wrong cohort. At boot and not merely
# on the request, because the console falls back to an unlabelled roster when
# /api/agents fails -- the labels would just quietly vanish.
AGENT_LANGUAGES=125:Hindi,127:Tamil

# ---------- Waves ----------
# Where the morning wave (`auto`) stops and the afternoon one (`auto_pm`) starts.
# HH:MM, 24-hour, default 13:30. Each wave's dialling is clipped to its side of
# this line, so a campaign open 09:00-20:00 dials 09:00-13:30 in the morning and
# 13:30-20:00 in the afternoon -- which is what makes the wave's name true.
#
# `api.main` loads this file before it imports the routers, and `api.day` parses
# and RANGE-CHECKS the value once at import, so a malformed one stops the API at
# boot rather than quietly dialling the wrong half of the day. Changing it needs
# a restart.
#
# It must fall strictly inside the 09:00-20:00 dialling hours. On or outside
# either edge one wave gets the whole day and the other an empty band for every
# campaign, with nothing downstream to say so: `WAVE_BOUNDARY=00:00` used to boot
# cleanly and shut the morning down across the board.
#
# Keep it between autopilot's two preparation times (10:00 and 15:00) too, or a
# wave is prepared outside the band it dials into. That one is advice, not
# enforced -- the dialling-hours range is.
WAVE_BOUNDARY=13:30
